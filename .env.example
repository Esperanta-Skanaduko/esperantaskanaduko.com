# Firebase Configuration
# Copy this file to .env and fill in your Firebase project values.
# Find these in the Firebase Console → Project Settings → Your Apps → SDK setup.
#
# IMPORTANT: Never commit .env to version control!
# The actual .env file is listed in .gitignore.
#
# For GitHub Pages CI/CD:
#   Add each variable as a GitHub Actions secret:
#   Settings → Secrets and variables → Actions → New repository secret

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Sentry error monitoring (optional — app works without it) ────────────────
# Create a project at https://sentry.io and copy the DSN from:
#   Settings → Projects → <your-project> → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# Sentry source-map upload (CI/CD build only — NOT a VITE_ prefix variable,
# never injected into the browser bundle).
# Generate at https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases  org:read
# Add as a GitHub Actions secret: SENTRY_AUTH_TOKEN
SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
