{
  "name": "esperantaskanaduko.com",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Esperanta Skanduko - A comprehensive Esperanto learning and resource website",
  "keywords": [
    "esperanto",
    "language-learning",
    "education",
    "react",
    "typescript",
    "vite",
    "firebase"
  ],
  "author": {
    "name": "Victor Williams",
    "email": "victor.williams.dev@gmail.com",
    "url": "https://github.com/Vaporjawn"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaporjawn/esperantaskanaduko.com.git"
  },
  "bugs": {
    "url": "https://github.com/Vaporjawn/esperantaskanaduko.com/issues"
  },
  "homepage": "https://esperantaskanaduko.com",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "check": "npm install && npm run build && eslint . --ext ts,tsx --max-warnings 0 && jest --coverage",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "firebase": "^10.14.1",
    "gh-pages": "^6.3.0",
    "i18next": "^25.5.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.0.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.23",
    "typescript": "^5.9.3",
    "vite": "^4.5.14"
  }
}
